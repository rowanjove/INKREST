{
  "name": "novel-agent-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.electron.json && electron dist-electron/main.js",
    "build": "rimraf dist && vue-tsc -b && vite build",
    "build:electron": "rimraf dist-electron && tsc -p tsconfig.electron.json",
    "build:backend": "cd ../.. && python -m PyInstaller --noconfirm --clean --onedir --name novel-agent-backend --distpath build/python-runtime --workpath build/pyinstaller-work --add-data \"web/frontend/dist;web/frontend/dist\" --add-data \"prompts;prompts\" --add-data \"presets;presets\" --exclude-module onnxruntime --exclude-module transformers --exclude-module torch --collect-all uvicorn --collect-all fastapi --collect-all pydantic --collect-all pydantic_core --collect-all novel_agent --collect-all pip main.py",
    "electron:build": "npm run build && npm run build:electron && npm run build:backend && electron-builder --win",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "dist:win": "npm run electron:build"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "element-plus": "^2.14.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.1.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.12",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.8"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.novelagent.desktop",
    "productName": "栖墨",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "build/icon.ico",
      "build/tray_icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "build/icon.png",
      "build/icon.ico",
      "build/tray_icon.png"
    ],
    "extraResources": [
      {
        "from": "../../build/python-runtime/novel-agent-backend",
        "to": "python-runtime/novel-agent-backend"
      },
      {
        "from": "../../prompts",
        "to": "templates/prompts"
      },
      {
        "from": "../../presets",
        "to": "templates/presets"
      },
      {
        "from": "../../assets",
        "to": "templates/assets"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
