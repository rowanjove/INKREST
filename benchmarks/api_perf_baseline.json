{
  "version": 2,
  "description": "Steady-state P95 latency ceilings (ms) for hot read APIs on seeded minimal project.",
  "warmup_iterations": 3,
  "iterations": 20,
  "endpoints": {
    "/api/health": 50,
    "/api/projects": 800,
    "/api/chapters?offset=0&limit=20": 600,
    "/api/novel/progress-summary": 1200,
    "/api/novel/batch-status": 1200,
    "/api/pipeline-alerts": 800,
    "/api/chapters/tasks": 400
  }
}
